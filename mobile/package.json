{
  "name": "szamlazo-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 8100 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "android:sync": "node scripts/configure-native.mjs && ng build --configuration native && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.2",
    "@ionic/angular": "9.0.13",
    "ionicons": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.0",
    "@capacitor/cli": "8.6.2",
    "typescript": "~6.0.2"
  }
}
